<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>CAMERA PARTOUT</title>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

body{
    font-family:Arial, sans-serif;
    background:#f4f6f8;
    color:#222;
}

header{
    background:#111;
    color:white;
    padding:18px;
    text-align:center;
}

.logo{
    font-size:30px;
    font-weight:bold;
}

.logo span{
    color:#e63946;
}

nav{
    background:#222;
    display:flex;
    flex-wrap:wrap;
    justify-content:center;
    gap:8px;
    padding:10px;
}

nav button{
    background:#333;
    color:white;
    border:none;
    padding:10px 14px;
    border-radius:6px;
    cursor:pointer;
}

nav button:hover{
    background:#e63946;
}

.hero{
    background:#e63946;
    color:white;
    text-align:center;
    padding:45px 20px;
}

.hero h1{
    font-size:38px;
    margin-bottom:10px;
}

.hero p{
    font-size:18px;
}

.container{
    width:94%;
    max-width:1200px;
    margin:25px auto;
}

.search-box{
    display:flex;
    gap:10px;
    margin-bottom:25px;
}

.search-box input{
    flex:1;
    padding:14px;
    border:1px solid #ccc;
    border-radius:7px;
    font-size:16px;
}

.section-title{
    margin:20px 0;
    font-size:25px;
}

.news-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:20px;
}

.news-card{
    background:white;
    border-radius:10px;
    overflow:hidden;
    box-shadow:0 2px 10px rgba(0,0,0,.1);
}

.news-card img{
    width:100%;
    height:210px;
    object-fit:cover;
}

.news-content{
    padding:18px;
}

.category{
    display:inline-block;
    background:#e63946;
    color:white;
    padding:5px 9px;
    border-radius:5px;
    font-size:12px;
    margin-bottom:10px;
}

.news-content h3{
    margin-bottom:10px;
}

.news-content p{
    line-height:1.5;
    color:#555;
}

.read-btn{
    margin-top:15px;
    padding:10px 15px;
    background:#111;
    color:white;
    border:none;
    border-radius:5px;
    cursor:pointer;
}

.page{
    display:none;
}

.active{
    display:block;
}

.form-box{
    background:white;
    padding:25px;
    max-width:700px;
    margin:25px auto;
    border-radius:10px;
    box-shadow:0 2px 10px rgba(0,0,0,.1);
}

.form-group{
    margin-bottom:18px;
}

.form-group label{
    display:block;
    font-weight:bold;
    margin-bottom:7px;
}

.form-group input,
.form-group textarea,
.form-group select{
    width:100%;
    padding:12px;
    border:1px solid #ccc;
    border-radius:6px;
    font-size:16px;
}

.form-group textarea{
    min-height:180px;
    resize:vertical;
}

.main-btn{
    background:#e63946;
    color:white;
    border:none;
    padding:13px 20px;
    border-radius:6px;
    cursor:pointer;
    font-size:16px;
}

.main-btn:hover{
    background:#c92f3c;
}

.photo-buttons{
    display:flex;
    gap:10px;
    flex-wrap:wrap;
}

.photo-btn{
    background:#111;
    color:white;
    border:none;
    padding:12px 15px;
    border-radius:6px;
    cursor:pointer;
}

#preview{
    width:100%;
    max-height:350px;
    object-fit:cover;
    margin-top:15px;
    border-radius:8px;
    display:none;
}

.message{
    padding:12px;
    border-radius:6px;
    margin:15px 0;
}

.success{
    background:#d1fae5;
    color:#065f46;
}

.error{
    background:#fee2e2;
    color:#991b1b;
}

.admin-bar{
    display:none;
    background:#111;
    color:white;
    padding:12px;
    text-align:center;
}

.admin-bar button{
    background:#e63946;
    color:white;
    border:none;
    padding:8px 14px;
    border-radius:5px;
    margin-left:10px;
    cursor:pointer;
}

.article{
    background:white;
    padding:25px;
    border-radius:10px;
    box-shadow:0 2px 10px rgba(0,0,0,.1);
}

.article img{
    width:100%;
    max-height:500px;
    object-fit:cover;
    border-radius:8px;
    margin:15px 0;
}

.article p{
    font-size:18px;
    line-height:1.8;
    white-space:pre-line;
}

footer{
    margin-top:50px;
    background:#111;
    color:white;
    text-align:center;
    padding:30px;
}

.loading{
    text-align:center;
    padding:40px;
    font-size:20px;
}

.empty{
    text-align:center;
    padding:40px;
    color:#777;
}

@media(max-width:600px){

    .logo{
        font-size:25px;
    }

    .hero h1{
        font-size:28px;
    }

    .search-box{
        flex-direction:column;
    }

    nav button{
        font-size:13px;
    }

    .photo-buttons{
        flex-direction:column;
    }

    .photo-btn{
        width:100%;
    }
}
</style>
</head>

<body>

<header>
    <div class="logo">
        📷 CAMERA <span>PARTOUT</span>
    </div>
    <p>News from Haiti and around the world</p>
</header>

<nav>

    <button onclick="showHome()">Home</button>

    <button onclick="filterCategory('Haïti')">
        Haïti
    </button>

    <button onclick="filterCategory('International')">
        International
    </button>

    <button onclick="filterCategory('Sport')">
        Sport
    </button>

    <button onclick="filterCategory('Économie')">
        Économie
    </button>

    <button onclick="filterCategory('Culture')">
        Culture
    </button>

    <button onclick="filterCategory('Technologie')">
        Technologie
    </button>

    <button onclick="showAdmin()">
        🔐 Admin
    </button>

</nav>

<div id="adminBar" class="admin-bar">

    🔐 ADMIN MODE ACTIVE

    <button onclick="showPublishPage()">
        Publish News
    </button>

    <button onclick="adminLogout()">
        Logout
    </button>

</div>


<!-- HOME -->

<div id="homePage" class="page active">

    <section class="hero">

        <h1>CAMERA PARTOUT</h1>

        <p>
            Stay informed. News everywhere.
        </p>

    </section>


    <main class="container">

        <div class="search-box">

            <input
                type="text"
                id="search"
                placeholder="Search news..."
                oninput="searchNews()"
            >

        </div>


        <h2 class="section-title">
            📰 Latest News
        </h2>


        <div id="newsGrid" class="news-grid">

            <div class="loading">
                Loading news...
            </div>

        </div>

    </main>

</div>


<!-- ARTICLE -->

<div id="articlePage" class="page">

    <main class="container">

        <button
            class="main-btn"
            onclick="showHome()"
        >
            ← Back
        </button>

        <br><br>

        <div id="articleContent"></div>

    </main>

</div>


<!-- ADMIN LOGIN -->

<div id="adminPage" class="page">

    <div class="form-box">

        <h2>🔐 Admin Login</h2>

        <br>

        <p>
            Enter the administrator code to publish news.
        </p>

        <br>

        <div class="form-group">

            <label>
                Admin Code
            </label>

            <input
                type="password"
                id="adminCode"
                placeholder="Enter admin code"
            >

        </div>

        <button
            class="main-btn"
            onclick="checkAdminCode()"
        >
            Login
        </button>

        <div id="adminMessage"></div>

    </div>

</div>


<!-- PUBLISH -->

<div id="publishPage" class="page">

    <div class="form-box">

        <h2>
            📰 Publish News
        </h2>

        <br>

        <div id="publishMessage"></div>


        <div class="form-group">

            <label>
                News Title
            </label>

            <input
                type="text"
                id="title"
                placeholder="Enter news title"
            >

        </div>


        <div class="form-group">

            <label>
                Category
            </label>

            <select id="category">

                <option value="Haïti">
                    Haïti
                </option>

                <option value="International">
                    International
                </option>

                <option value="Sport">
                    Sport
                </option>

                <option value="Économie">
                    Économie
                </option>

                <option value="Culture">
                    Culture
                </option>

                <option value="Technologie">
                    Technologie
                </option>

            </select>

        </div>


        <!-- PHOTO -->

        <div class="form-group">

            <label>
                📸 News Photo
            </label>

            <div class="photo-buttons">

                <button
                    type="button"
                    class="photo-btn"
                    onclick="uploadPicture()"
                >
                    📤 Upload Picture
                </button>

                <button
                    type="button"
                    class="photo-btn"
                    onclick="takePhoto()"
                >
                    📷 Take Photo
                </button>

            </div>


            <input
                id="photo"
                type="file"
                accept="image/*"
                hidden
                onchange="pictureSelected()"
            >


            <input
                id="camera"
                type="file"
                accept="image/*"
                capture="environment"
                hidden
                onchange="cameraSelected()"
            >


            <img
                id="preview"
                alt="Selected news photo"
            >

        </div>


        <div class="form-group">

            <label>
                News
            </label>

            <textarea
                id="content"
                placeholder="Write your news here..."
            ></textarea>

        </div>


        <button
            class="main-btn"
            onclick="publishNews()"
        >
            🚀 Publish News
        </button>

    </div>

</div>


<footer>

    <h3>
        📷 CAMERA PARTOUT
    </h3>

    <br>

    <p>
        News everywhere, anytime.
    </p>

    <br>

    <p>
        © 2026 CAMERA PARTOUT
    </p>

</footer>


<script>

/* =====================================
   SUPABASE
===================================== */

const SUPABASE_URL =
"https://nioetezsutbxxrwpsexb.supabase.co";

const SUPABASE_KEY =
"sb_publishable_nB197b7wwsay5oqd1zsfxA_eHmDRDcH";


const supabaseClient =
window.supabase.createClient(
    SUPABASE_URL,
    SUPABASE_KEY
);


/* =====================================
   ADMIN
===================================== */

const ADMIN_CODE = "GODISGOOD";

let isAdmin = false;

let news = [];


/* =====================================
   PAGE SYSTEM
===================================== */

function hideAllPages(){

    document
    .querySelectorAll(".page")
    .forEach(page => {

        page.classList.remove("active");

    });

}


function showHome(){

    hideAllPages();

    document
    .getElementById("homePage")
    .classList.add("active");

    loadNews();

}


function showAdmin(){

    hideAllPages();

    document
    .getElementById("adminPage")
    .classList.add("active");

}


function showPublishPage(){

    if(!isAdmin){

        showAdmin();

        return;

    }

    hideAllPages();

    document
    .getElementById("publishPage")
    .classList.add("active");

}


/* =====================================
   ADMIN LOGIN
===================================== */

function checkAdminCode(){

    const code =
    document
    .getElementById("adminCode")
    .value;

    const message =
    document
    .getElementById("adminMessage");


    if(code === ADMIN_CODE){

        isAdmin = true;

        sessionStorage.setItem(
            "camera_partout_admin",
            "true"
        );


        message.innerHTML =
        `
        <div class="message success">
            ✅ Admin access granted!
        </div>
        `;


        document
        .getElementById("adminCode")
        .value = "";


        updateAdminBar();


        setTimeout(
            showPublishPage,
            500
        );


    }else{

        isAdmin = false;


        message.innerHTML =
        `
        <div class="message error">
            ❌ Wrong admin code.
        </div>
        `;

    }

}


/* =====================================
   ADMIN BAR
===================================== */

function updateAdminBar(){

    const bar =
    document
    .getElementById("adminBar");


    if(isAdmin){

        bar.style.display = "block";

    }else{

        bar.style.display = "none";

    }

}


/* =====================================
   LOGOUT
===================================== */

function adminLogout(){

    isAdmin = false;

    sessionStorage.removeItem(
        "camera_partout_admin"
    );

    updateAdminBar();

    showHome();

    alert("Admin logged out.");

}


/* =====================================
   PHOTO UPLOAD
===================================== */

function uploadPicture(){

    document
    .getElementById("photo")
    .click();

}


function takePhoto(){

    document
    .getElementById("camera")
    .click();

}


function pictureSelected(){

    const file =
    document
    .getElementById("photo")
    .files[0];

    showPicturePreview(file);

}


function cameraSelected(){

    const file =
    document
    .getElementById("camera")
    .files[0];

    showPicturePreview(file);

}


function showPicturePreview(file){

    if(!file) return;


    const preview =
    document
    .getElementById("preview");


    const reader =
    new FileReader();


    reader.onload =
    function(e){

        preview.src =
        e.target.result;

        preview.style.display =
        "block";

    };


    reader.readAsDataURL(file);

}


/* =====================================
   PUBLISH NEWS
===================================== */

async function publishNews(){

    if(!isAdmin){

        alert("Admin access required.");

        return;

    }


    const title =
    document
    .getElementById("title")
    .value
    .trim();


    const category =
    document
    .getElementById("category")
    .value;


    const content =
    document
    .getElementById("content")
    .value
    .trim();


    const galleryPhoto =
    document
    .getElementById("photo")
    .files[0];


    const cameraPhoto =
    document
    .getElementById("camera")
    .files[0];


    const photo =
    galleryPhoto || cameraPhoto;


    const message =
    document
    .getElementById("publishMessage");


    if(!title){

        message.innerHTML =
        `
        <div class="message error">
            Please enter a title.
        </div>
        `;

        return;

    }


    if(!content){

        message.innerHTML =
        `
        <div class="message error">
            Please write the news.
        </div>
        `;

        return;

    }


    try{

        message.innerHTML =
        `
        <div class="message">
            ⏳ Publishing...
        </div>
        `;


        let imageUrl = null;


        /* =========================
           UPLOAD IMAGE
        ========================= */

        if(photo){

            const extension =
            photo.name
            .split(".")
            .pop()
            .toLowerCase();


            const fileName =
            Date.now()
            +
            "-"
            +
            Math.random()
            .toString(36)
            .substring(2)
            +
            "."
            +
            extension;


            const {
                error:uploadError
            } =
            await supabaseClient
            .storage
            .from("news-images")
            .upload(
                fileName,
                photo,
                {
                    cacheControl:"3600",
                    upsert:false
                }
            );


            if(uploadError){

                throw uploadError;

            }


            const {
                data:urlData
            } =
            supabaseClient
            .storage
            .from("news-images")
            .getPublicUrl(fileName);


            imageUrl =
            urlData.publicUrl;

        }


        /* =========================
           SAVE NEWS
        ========================= */

        const {
            error:insertError
        } =
        await supabaseClient
        .from("news")
        .insert([{

            title:title,

            category:category,

            content:content,

            image:imageUrl

        }]);


        if(insertError){

            throw insertError;

        }


        message.innerHTML =
        `
        <div class="message success">
            ✅ News published successfully!
        </div>
        `;


        /* CLEAR FORM */

        document
        .getElementById("title")
        .value = "";


        document
        .getElementById("content")
        .value = "";


        document
        .getElementById("photo")
        .value = "";


        document
        .getElementById("camera")
        .value = "";


        const preview =
        document
        .getElementById("preview");


        preview.src = "";

        preview.style.display =
        "none";


        await loadNews();


    }catch(error){

        console.error(error);


        message.innerHTML =
        `
        <div class="message error">
            ❌ Error: ${escapeHTML(error.message)}
        </div>
        `;

    }

}


/* =====================================
   LOAD NEWS
===================================== */

async function loadNews(){

    const grid =
    document
    .getElementById("newsGrid");


    try{

        const {
            data,
            error
        } =
        await supabaseClient
        .from("news")
        .select("*")
        .order(
            "created_at",
            {
                ascending:false
            }
        );


        if(error){

            throw error;

        }


        news =
        data || [];


        displayNews(news);


    }catch(error){

        console.error(error);


        grid.innerHTML =
        `
        <div class="message error">
            ❌ Could not load news.
            <br><br>
            ${escapeHTML(error.message)}
        </div>
        `;

    }

}


/* =====================================
   DISPLAY NEWS
===================================== */

function displayNews(list){

    const grid =
    document
    .getElementById("newsGrid");


    if(!list.length){

        grid.innerHTML =
        `
        <div class="empty">
            No news published yet.
        </div>
        `;

        return;

    }


    grid.innerHTML =
    list
    .map((item,index) => {


        const image =
        item.image
        ||
        "https://images.unsplash.com/photo-1504711434969-e33886168f5c?auto=format&fit=crop&w=900&q=80";


        const shortContent =
        item.content.length > 150
        ?
        item.content.substring(0,150) + "..."
        :
        item.content;


        return `

        <article class="news-card">

            <img
                src="${escapeAttribute(image)}"
                alt="${escapeAttribute(item.title)}"
            >

            <div class="news-content">

                <span class="category">
                    ${escapeHTML(item.category)}
                </span>

                <h3>
                    ${escapeHTML(item.title)}
                </h3>

                <p>
                    ${escapeHTML(shortContent)}
                </p>

                <button
                    class="read-btn"
                    onclick="openArticle(${index})"
                >
                    Read More
                </button>

            </div>

        </article>

        `;

    })
    .join("");

}


/* =====================================
   OPEN ARTICLE
===================================== */

function openArticle(index){

    const item =
    news[index];


    if(!item) return;


    hideAllPages();


    document
    .getElementById("articlePage")
    .classList.add("active");


    const image =
    item.image
    ?
    `
    <img
        src="${escapeAttribute(item.image)}"
        alt="${escapeAttribute(item.title)}"
    >
    `
    :
    "";


    document
    .getElementById("articleContent")
    .innerHTML =
    `

    <div class="article">

        <span class="category">
            ${escapeHTML(item.category)}
        </span>

        <h1>
            ${escapeHTML(item.title)}
        </h1>

        ${image}

        <p>
            ${escapeHTML(item.content)}
        </p>

    </div>

    `;

}


/* =====================================
   SEARCH
===================================== */

function searchNews(){

    const query =
    document
    .getElementById("search")
    .value
    .toLowerCase()
    .trim();


    const results =
    news.filter(item =>

        item.title
        .toLowerCase()
        .includes(query)

        ||

        item.content
        .toLowerCase()
        .includes(query)

        ||

        item.category
        .toLowerCase()
        .includes(query)

    );


    displayNews(results);

}


/* =====================================
   CATEGORY
===================================== */

function filterCategory(category){

    hideAllPages();


    document
    .getElementById("homePage")
    .classList.add("active");


    const results =
    news.filter(item =>
        item.category === category
    );


    displayNews(results);

}


/* =====================================
   SECURITY HELPERS
===================================== */

function escapeHTML(value){

    if(value === null || value === undefined){

        return "";

    }


    return String(value)
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");

}


function escapeAttribute(value){

    return escapeHTML(value);

}


/* =====================================
   START
===================================== */

const savedAdmin =
sessionStorage.getItem(
    "camera_partout_admin"
);


if(savedAdmin === "true"){

    isAdmin = true;

}


updateAdminBar();

loadNews();

showHome();

</script>

</body>
</html>
